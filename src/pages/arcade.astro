---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="8086 VGA Karate // Arcade Easter Egg">
  <section class="max-w-3xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4">
      <div>
        <div class="text-xs text-brand-accent font-bold tracking-wider">
          // DOS_BOX // MODE_13H_320x200
        </div>

        <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
          8086 VGA KARATE
        </h1>
      </div>

      <div class="flex items-center space-x-3">
        <button
          id="mute-btn"
          class="text-xs bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 px-3 py-1.5 rounded transition-colors"
        >
          PC Speaker: ON
        </button>

        <button
          id="pause-btn"
          class="text-xs bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 px-3 py-1.5 rounded transition-colors"
        >
          Pause [P]
        </button>

        <button
          id="reset-btn"
          class="text-xs bg-brand-accent hover:bg-sky-400 text-brand-dark font-bold px-3 py-1.5 rounded transition-colors"
        >
          New Match [R]
        </button>
      </div>
    </div>

    <div class="bg-slate-900 p-3 sm:p-5 rounded-xl border-2 border-slate-800 shadow-2xl">
      <div class="relative w-full aspect-[16/10] bg-black rounded overflow-hidden border border-slate-700">
        <canvas
          id="vga-canvas"
          width="320"
          height="200"
          class="w-full h-full block"
          style="image-rendering: pixelated; image-rendering: crisp-edges;"
        ></canvas>

        <div
          class="pointer-events-none absolute inset-0 opacity-20"
          style="background: repeating-linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.6) 0px,
            rgba(0, 0, 0, 0.6) 1px,
            transparent 1px,
            transparent 3px
          );"
        ></div>
      </div>

      <div class="flex items-center justify-between pt-3 px-1 text-[10px] text-slate-500">
        <span>IBM VGA 256-COLOR PALETTE // FSM COMBAT ENGINE</span>

        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          POWER
        </span>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 sm:hidden select-none">
      <button data-key="ArrowLeft" class="touch-btn bg-slate-900 border border-slate-700 active:bg-slate-700 py-3 rounded text-xs font-bold text-white">
        ◀ LEFT
      </button>

      <button data-key="ArrowRight" class="touch-btn bg-slate-900 border border-slate-700 active:bg-slate-700 py-3 rounded text-xs font-bold text-white">
        RIGHT ▶
      </button>

      <button data-key="ShiftLeft" class="touch-btn bg-slate-900 border border-violet-500/40 active:bg-violet-500/20 py-3 rounded text-xs font-bold text-violet-300">
        DASH
      </button>

      <button data-key="KeyW" class="touch-btn bg-slate-900 border border-amber-500/40 active:bg-amber-500/20 py-3 rounded text-xs font-bold text-amber-400">
        BLOCK
      </button>

      <button data-key="KeyJ" class="touch-btn bg-slate-900 border border-brand-accent/40 active:bg-brand-accent/20 py-3 rounded text-xs font-bold text-brand-accent">
        PUNCH
      </button>

      <button data-key="KeyK" class="touch-btn bg-slate-900 border border-emerald-500/40 active:bg-emerald-500/20 py-3 rounded text-xs font-bold text-emerald-400">
        KICK
      </button>

      <button data-key="KeyL" class="touch-btn bg-slate-900 border border-rose-500/40 active:bg-rose-500/20 py-3 rounded text-xs font-bold text-rose-400">
        LOW
      </button>

      <button data-key="KeyP" class="touch-btn bg-slate-900 border border-slate-700 active:bg-slate-700 py-3 rounded text-xs font-bold text-white">
        PAUSE
      </button>

      <button data-key="KeyR" class="touch-btn bg-slate-900 border border-slate-700 active:bg-slate-700 py-3 rounded text-xs font-bold text-white">
        RESET
      </button>
    </div>

    <div class="bg-slate-900/40 border border-slate-800/80 rounded-lg p-4 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
      <div>
        <span class="text-slate-500 block text-[10px]">MOVE</span>
        <span class="text-white font-bold">[A / D] or [← / →]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">HIGH BLOCK</span>
        <span class="text-amber-400 font-bold">[W] or [↑]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">JAB PUNCH</span>
        <span class="text-brand-accent font-bold">[J] or [Z]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">HIGH KICK</span>
        <span class="text-emerald-400 font-bold">[K] or [X]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">LOW KICK</span>
        <span class="text-rose-400 font-bold">[L] or [C]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">DASH</span>
        <span class="text-violet-300 font-bold">[SHIFT]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">PAUSE</span>
        <span class="text-white font-bold">[P] or [ESC]</span>
      </div>

      <div>
        <span class="text-slate-500 block text-[10px]">RESET MATCH</span>
        <span class="text-white font-bold">[R]</span>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const canvas = document.getElementById('vga-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  ctx.imageSmoothingEnabled = false;

  const ARENA = {
    width: 320,
    height: 200,
    floorY: 168,
    minX: 28,
    maxX: 292,
  };

  const MATCH = {
    roundsToWin: 2,
    roundTime: 60,
  };

  type FighterState =
    | 'IDLE'
    | 'WALK'
    | 'BLOCK'
    | 'PUNCH'
    | 'KICK'
    | 'LOW_KICK'
    | 'DASH'
    | 'STUN'
    | 'KO';

  interface Fighter {
    name: string;
    x: number;
    facing: 1 | -1;
    hp: number;
    maxHp: number;
    state: FighterState;
    timer: number;
    hasHit: boolean;
    dashCooldown: number;
    combo: number;
    giColor: string;
    giShade: string;
    beltColor: string;
    headband: string;
  }

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    color: string;
  }

  type GamePhase = 'TITLE' | 'FIGHT' | 'ROUND_OVER' | 'MATCH_OVER' | 'PAUSED';

  const keys: Record<string, boolean> = {};

  let gamePhase: GamePhase = 'TITLE';
  let bannerText = 'PRESS SPACE OR ATTACK TO START';
  let roundNum = 1;
  let playerWins = 0;
  let cpuWins = 0;
  let roundTimer = MATCH.roundTime;
  let screenShake = 0;
  let hitFlash = 0;
  let aiDecisionCooldown = 0;
  let lastTimestamp = 0;

  const particles: Particle[] = [];

  let player = createFighter(true);
  let cpu = createFighter(false);

  const sfx = {
    whiff: () => playTone(260, 0.08, 'square', 110),
    hit: () => playTone(150, 0.14, 'sawtooth', 45),
    lowHit: () => playTone(110, 0.18, 'sawtooth', 35),
    block: () => playTone(520, 0.07, 'square', 680),
    dash: () => playTone(720, 0.06, 'square', 220),
    gong: () => playTone(196, 0.45, 'triangle', 146),
    win: () => {
      playTone(330, 0.12, 'square');
      setTimeout(() => playTone(440, 0.12, 'square'), 130);
      setTimeout(() => playTone(659, 0.28, 'square'), 260);
    },
  };

  function createFighter(isPlayer: boolean): Fighter {
    return {
      name: isPlayer ? 'AJDANOFF' : 'DOJO CPU',
      x: isPlayer ? 85 : 235,
      facing: isPlayer ? 1 : -1,
      hp: 100,
      maxHp: 100,
      state: 'IDLE',
      timer: 0,
      hasHit: false,
      dashCooldown: 0,
      combo: 0,
      giColor: isPlayer ? '#F8FAFC' : '#38BDF8',
      giShade: isPlayer ? '#CBD5E1' : '#0284C7',
      beltColor: isPlayer ? '#0F172A' : '#EF4444',
      headband: isPlayer ? '#EF4444' : '#FACC15',
    };
  }

  function startRound() {
    player = createFighter(true);
    cpu = createFighter(false);

    roundTimer = MATCH.roundTime;
    aiDecisionCooldown = 0;
    particles.length = 0;

    gamePhase = 'FIGHT';
    bannerText = '';

    sfx.gong();
  }

  function resetMatch() {
    roundNum = 1;
    playerWins = 0;
    cpuWins = 0;

    startRound();
  }

  function triggerAttack(fighter: Fighter, attack: 'PUNCH' | 'KICK' | 'LOW_KICK') {
    if (fighter.state !== 'IDLE' && fighter.state !== 'WALK') {
      return;
    }

    fighter.state = attack;
    fighter.hasHit = false;

    if (attack === 'PUNCH') {
      fighter.timer = 18;
    } else if (attack === 'KICK') {
      fighter.timer = 26;
    } else {
      fighter.timer = 30;
    }

    sfx.whiff();
  }

  function tryDash(fighter: Fighter) {
    if (
      fighter.state !== 'IDLE' &&
      fighter.state !== 'WALK' ||
      fighter.dashCooldown > 0
    ) {
      return;
    }

    fighter.state = 'DASH';
    fighter.timer = 10;
    fighter.dashCooldown = 45;

    sfx.dash();
  }

  function playTone(
    frequency: number,
    duration: number,
    type: OscillatorType = 'square',
    slideTo?: number,
  ) {
    if (muted) {
      return;
    }

    if (!audioContext) {
      audioContext = new (window.AudioContext ||
        (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
    }

    if (audioContext.state === 'suspended') {
      audioContext.resume();
    }

    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();

    oscillator.type = type;
    oscillator.frequency.setValueAtTime(frequency, audioContext.currentTime);

    if (slideTo) {
      oscillator.frequency.exponentialRampToValueAtTime(
        slideTo,
        audioContext.currentTime + duration,
      );
    }

    gain.gain.setValueAtTime(0.08, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(
      0.001,
      audioContext.currentTime + duration,
    );

    oscillator.connect(gain);
    gain.connect(audioContext.destination);

    oscillator.start();
    oscillator.stop(audioContext.currentTime + duration);
  }

  let muted = false;
  let audioContext: AudioContext | null = null;

  function spawnHitSparks(x: number, y: number, color: string) {
    for (let index = 0; index < 12; index++) {
      particles.push({
        x,
        y,
        vx: (Math.random() - 0.5) * 5,
        vy: (Math.random() - 0.7) * 4,
        life: 12 + Math.floor(Math.random() * 8),
        color,
      });
    }
  }

  function updateParticles() {
    for (let index = particles.length - 1; index >= 0; index--) {
      const particle = particles[index];

      particle.x += particle.vx;
      particle.y += particle.vy;
      particle.vy += 0.18;
      particle.life--;

      if (particle.life <= 0) {
        particles.splice(index, 1);
      }
    }
  }

  function drawParticles() {
    for (const particle of particles) {
      ctx.fillStyle = particle.color;
      ctx.fillRect(
        Math.round(particle.x),
        Math.round(particle.y),
        2,
        2,
      );
    }
  }

  function updateAI() {
    if (cpu.state === 'STUN' || cpu.state === 'KO') {
      return;
    }

    const distance = Math.abs(cpu.x - player.x);

    cpu.facing = player.x < cpu.x ? -1 : 1;

    if (
      cpu.state === 'PUNCH' ||
      cpu.state === 'KICK' ||
      cpu.state === 'LOW_KICK' ||
      cpu.state === 'DASH'
    ) {
      return;
    }

    if (aiDecisionCooldown > 0) {
      aiDecisionCooldown--;
      return;
    }

    const difficulty = Math.min(roundNum - 1, 4);
    const blockChance = 0.5 + difficulty * 0.07;
    const attackChance = 0.05 + difficulty * 0.015;

    if (
      (player.state === 'PUNCH' ||
        player.state === 'KICK' ||
        player.state === 'LOW_KICK') &&
      distance < 55 &&
      Math.random() < blockChance
    ) {
      cpu.state = 'BLOCK';
      cpu.timer = 16;
      aiDecisionCooldown = 14;

      return;
    }

    if (distance > 70 && Math.random() < 0.03 + difficulty * 0.01) {
      tryDash(cpu);

      return;
    }

    if (distance > 44) {
      cpu.state = 'WALK';
      cpu.x += cpu.facing * 1.35;

      return;
    }

    if (distance < 26) {
      cpu.state = 'WALK';
      cpu.x -= cpu.facing * 1.2;

      return;
    }

    cpu.state = 'IDLE';

    const roll = Math.random();

    if (roll < attackChance) {
      triggerAttack(cpu, 'PUNCH');
      aiDecisionCooldown = 22;
    } else if (roll < attackChance * 1.7) {
      triggerAttack(cpu, 'KICK');
      aiDecisionCooldown = 28;
    } else if (roll < attackChance * 2.2) {
      triggerAttack(cpu, 'LOW_KICK');
      aiDecisionCooldown = 30;
    } else if (roll < attackChance * 2.5) {
      cpu.state = 'BLOCK';
      cpu.timer = 18;
      aiDecisionCooldown = 20;
    }
  }

  function updateFighter(
    attacker: Fighter,
    defender: Fighter,
    isPlayer: boolean,
  ) {
    if (attacker.state !== 'KO') {
      attacker.facing = defender.x > attacker.x ? 1 : -1;
    }

    if (
      isPlayer &&
      (attacker.state === 'IDLE' ||
        attacker.state === 'WALK' ||
        attacker.state === 'BLOCK')
    ) {
      if (keys['KeyW'] || keys['ArrowUp']) {
        attacker.state = 'BLOCK';
      } else if (keys['KeyA'] || keys['ArrowLeft']) {
        attacker.state = 'WALK';
        attacker.x -= 1.65;
      } else if (keys['KeyD'] || keys['ArrowRight']) {
        attacker.state = 'WALK';
        attacker.x += 1.65;
      } else {
        attacker.state = 'IDLE';
      }
    }

    if (attacker.state === 'DASH') {
      attacker.x += attacker.facing * 3.4;
    }

    attacker.x = Math.max(ARENA.minX, Math.min(ARENA.maxX, attacker.x));

    if (attacker.dashCooldown > 0) {
      attacker.dashCooldown--;
    }

    if (attacker.timer > 0) {
      attacker.timer--;

      if (attacker.timer === 0 && attacker.state !== 'KO') {
        attacker.state = 'IDLE';
      }
    }

    resolveAttack(attacker, defender, isPlayer);
  }

  function resolveAttack(
    attacker: Fighter,
    defender: Fighter,
    isPlayer: boolean,
  ) {
    const punchActive =
      attacker.state === 'PUNCH' &&
      attacker.timer >= 8 &&
      attacker.timer <= 13;

    const kickActive =
      attacker.state === 'KICK' &&
      attacker.timer >= 11 &&
      attacker.timer <= 18;

    const lowKickActive =
      attacker.state === 'LOW_KICK' &&
      attacker.timer >= 13 &&
      attacker.timer <= 20;

    if (!punchActive && !kickActive && !lowKickActive) {
      return;
    }

    if (attacker.hasHit || defender.state === 'KO') {
      return;
    }

    const reach = punchActive ? 38 : kickActive ? 48 : 42;
    const distance = (defender.x - attacker.x) * attacker.facing;

    if (distance <= 10 || distance > reach) {
      return;
    }

    attacker.hasHit = true;

    const isLowAttack = lowKickActive;
    const isBlocked =
      defender.state === 'BLOCK' && !isLowAttack;

    const impactX = defender.x - defender.facing * 10;
    const impactY = isLowAttack ? 158 : 132;

    if (isBlocked) {
      sfx.block();

      defender.x += attacker.facing * 6;
      defender.hp = Math.max(1, defender.hp - 2);

      spawnHitSparks(impactX, impactY, '#FACC15');

      return;
    }

    const damage = punchActive ? 10 : kickActive ? 16 : 20;

    sfx.hit();
    screenShake = isLowAttack ? 7 : 5;
    hitFlash = 4;

    defender.hp = Math.max(0, defender.hp - damage);
    defender.x += attacker.facing * (isLowAttack ? 15 : 12);
    defender.combo = 0;

    attacker.combo++;

    spawnHitSparks(
      impactX,
      impactY,
      isLowAttack ? '#FB7185' : '#FDE68A',
    );

    if (defender.hp === 0) {
      defender.state = 'KO';
      endRound(isPlayer);

      return;
    }

    defender.state = 'STUN';
    defender.timer = isLowAttack ? 18 : 14;
  }

  function endRound(playerWon: boolean) {
    gamePhase = 'ROUND_OVER';

    if (playerWon) {
      playerWins++;
      bannerText = 'YOU WIN THE ROUND!';
      sfx.win();
    } else {
      cpuWins++;
      bannerText = 'CPU WINS THE ROUND!';
      sfx.gong();
    }

    if (playerWins >= MATCH.roundsToWin || cpuWins >= MATCH.roundsToWin) {
      gamePhase = 'MATCH_OVER';

      bannerText = playerWins > cpuWins
        ? 'MATCH WON! PRESS SPACE TO PLAY AGAIN'
        : 'MATCH LOST! PRESS SPACE TO RETRY';
    }
  }

  function drawBackground() {
    ctx.fillStyle = '#071329';
    ctx.fillRect(0, 0, ARENA.width, 60);

    ctx.fillStyle = '#0C2147';
    ctx.fillRect(0, 60, ARENA.width, 45);

    ctx.fillStyle = '#153466';
    ctx.fillRect(0, 105, ARENA.width, 35);

    ctx.fillStyle = '#F59E0B';
    ctx.beginPath();
    ctx.arc(255, 52, 18, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#0F172A';
    ctx.beginPath();
    ctx.moveTo(140, 140);
    ctx.lineTo(215, 72);
    ctx.lineTo(235, 72);
    ctx.lineTo(310, 140);
    ctx.fill();

    ctx.fillStyle = '#E2E8F0';
    ctx.beginPath();
    ctx.moveTo(197, 88);
    ctx.lineTo(215, 72);
    ctx.lineTo(235, 72);
    ctx.lineTo(252, 88);
    ctx.lineTo(238, 84);
    ctx.lineTo(225, 91);
    ctx.lineTo(212, 84);
    ctx.fill();

    ctx.fillStyle = '#7F1D1D';
    ctx.fillRect(42, 78, 6, 62);
    ctx.fillRect(88, 78, 6, 62);

    ctx.fillStyle = '#B91C1C';
    ctx.fillRect(32, 74, 72, 6);
    ctx.fillRect(38, 88, 60, 4);

    ctx.fillStyle = '#1E293B';
    ctx.fillRect(0, 140, ARENA.width, 60);

    ctx.fillStyle = '#334155';
    ctx.fillRect(0, 140, ARENA.width, 3);

    ctx.fillStyle = '#0F172A';

    for (let x = 0; x <= ARENA.width; x += 32) {
      ctx.fillRect(x, 143, 2, 57);
    }

    ctx.fillRect(0, 162, ARENA.width, 2);
    ctx.fillRect(0, 184, ARENA.width, 2);
  }

  function drawFighter(fighter: Fighter, tick: number) {
    ctx.save();

    const bob =
      fighter.state === 'IDLE'
        ? Math.floor(Math.sin(tick * 0.15) * 1.5)
        : 0;

    const walkStride =
      fighter.state === 'WALK'
        ? Math.floor(Math.sin(tick * 0.35) * 4)
        : 0;

    ctx.translate(Math.round(fighter.x), ARENA.floorY + bob);
    ctx.scale(fighter.facing, 1);

    ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
    ctx.fillRect(-14, -2, 28, 5);

    if (fighter.state === 'KO') {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(-24, -10, 36, 10);

      ctx.fillStyle = fighter.beltColor;
      ctx.fillRect(-8, -10, 4, 10);

      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(12, -10, 10, 9);

      ctx.fillStyle = fighter.headband;
      ctx.fillRect(15, -10, 3, 9);

      ctx.restore();

      return;
    }

    const torsoShift = fighter.state === 'STUN' ? -4 : 0;

    ctx.fillStyle = fighter.giShade;
    ctx.fillRect(-9 - walkStride, -24, 7, 24);

    if (fighter.state === 'KICK') {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(4, -34, 28, 7);

      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(32, -35, 6, 7);
    } else if (fighter.state === 'LOW_KICK') {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(4, -16, 26, 7);

      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(30, -17, 6, 7);
    } else {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(2 + walkStride, -24, 7, 24);
    }

    ctx.fillStyle = fighter.giColor;
    ctx.fillRect(-10 + torsoShift, -48, 20, 25);

    ctx.fillStyle = fighter.beltColor;
    ctx.fillRect(-10 + torsoShift, -28, 20, 4);
    ctx.fillRect(2 + torsoShift, -24, 4, 7);

    ctx.fillStyle = '#FDBA74';
    ctx.fillRect(-6 + torsoShift, -61, 13, 12);

    ctx.fillStyle = '#0F172A';
    ctx.fillRect(-7 + torsoShift, -63, 14, 4);

    ctx.fillStyle = fighter.headband;
    ctx.fillRect(-7 + torsoShift, -59, 14, 3);
    ctx.fillRect(-11 + torsoShift, -58, 4, 6);

    if (fighter.state === 'PUNCH') {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(6, -45, 22, 6);

      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(28, -45, 6, 6);
    } else if (fighter.state === 'BLOCK') {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(7, -54, 6, 18);

      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(7, -58, 6, 5);
    } else if (fighter.state === 'LOW_KICK') {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(2 + torsoShift, -40, 10, 6);
    } else {
      ctx.fillStyle = fighter.giColor;
      ctx.fillRect(4 + torsoShift, -44, 10, 6);

      ctx.fillStyle = '#FDBA74';
      ctx.fillRect(14 + torsoShift, -45, 5, 5);
    }

    ctx.restore();
  }

  function drawHUD() {
    ctx.font = 'bold 8px monospace';

    drawHealthBar(player, 12, `${player.name} [${playerWins}]`, 'left');
    drawHealthBar(cpu, 198, `[${cpuWins}] ${cpu.name}`, 'right');

    ctx.fillStyle = '#38BDF8';
    ctx.textAlign = 'center';
    ctx.fillText(`R-${roundNum}`, 160, 14);

    const seconds = Math.max(0, Math.ceil(roundTimer));
    ctx.fillStyle = seconds <= 10 ? '#EF4444' : '#F8FAFC';
    ctx.fillText(`${seconds}s`, 160, 26);

    if (player.combo >= 2) {
      ctx.fillStyle = '#FACC15';
      ctx.fillText(`${player.combo} HIT COMBO`, 160, 42);
    }

    ctx.textAlign = 'left';

    if (gamePhase !== 'FIGHT') {
      drawBanner();
    }
  }

  function drawHealthBar(
    fighter: Fighter,
    x: number,
    label: string,
    align: 'left' | 'right',
  ) {
    ctx.fillStyle = '#FFFFFF';
    ctx.textAlign = align;
    ctx.fillText(label, align === 'left' ? x : x + 110, 14);

    const barWidth = Math.round((fighter.hp / fighter.maxHp) * 110);
    const barX = align === 'left' ? x : x + (110 - barWidth);

    ctx.fillStyle = '#1E293B';
    ctx.fillRect(x, 18, 110, 8);

    ctx.fillStyle = fighter.hp > 30 ? '#10B981' : '#EF4444';
    ctx.fillRect(barX, 18, barWidth, 8);

    ctx.strokeStyle = '#64748B';
    ctx.strokeRect(x, 18, 110, 8);

    ctx.textAlign = 'left';
  }

  function drawBanner() {
    ctx.fillStyle = 'rgba(11, 15, 25, 0.78)';
    ctx.fillRect(18, 78, 284, 42);

    ctx.strokeStyle = '#38BDF8';
    ctx.strokeRect(18, 78, 284, 42);

    ctx.fillStyle = '#F8FAFC';
    ctx.font = 'bold 9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(bannerText, 160, 102);

    ctx.textAlign = 'left';
  }

  function updateGame(deltaTime: number) {
    if (gamePhase !== 'FIGHT') {
      updateParticles();

      return;
    }

    roundTimer -= deltaTime;

    if (roundTimer <= 0) {
      roundTimer = 0;

      if (player.hp === cpu.hp) {
        bannerText = 'DRAW! PRESS SPACE FOR NEXT ROUND';
      } else {
        endRound(player.hp > cpu.hp);
      }

      gamePhase = 'ROUND_OVER';

      return;
    }

    updateAI();
    updateFighter(player, cpu, true);
    updateFighter(cpu, player, false);
    updateParticles();
  }

  function loop(timestamp: number) {
    const deltaTime = lastTimestamp === 0
      ? 0
      : Math.min((timestamp - lastTimestamp) / 1000, 0.1);

    lastTimestamp = timestamp;
    tick++;

    if (gamePhase !== 'PAUSED') {
      updateGame(deltaTime);
    }

    ctx.save();

    if (screenShake > 0) {
      ctx.translate(
        Math.round((Math.random() - 0.5) * 4),
        Math.round((Math.random() - 0.5) * 4),
      );

      screenShake--;
    }

    drawBackground();
    drawFighter(cpu, tick);
    drawFighter(player, tick);
    drawParticles();
    drawHUD();

    if (hitFlash > 0) {
      ctx.fillStyle = `rgba(255, 255, 255, ${hitFlash * 0.05})`;
      ctx.fillRect(0, 0, ARENA.width, ARENA.height);
      hitFlash--;
    }

    ctx.restore();

    requestAnimationFrame(loop);
  }

  function handleStartOrContinue() {
    if (gamePhase === 'TITLE' || gamePhase === 'PAUSED') {
      startRound();

      return;
    }

    if (gamePhase === 'ROUND_OVER') {
      roundNum++;
      startRound();

      return;
    }

    if (gamePhase === 'MATCH_OVER') {
      resetMatch();
    }
  }

  window.addEventListener('keydown', (event) => {
    if (
      [
        'ArrowUp',
        'ArrowDown',
        'ArrowLeft',
        'ArrowRight',
        'Space',
      ].includes(event.code)
    ) {
      event.preventDefault();
    }

    keys[event.code] = true;

    if (event.code === 'KeyR') {
      resetMatch();

      return;
    }

    if (event.code === 'KeyP' || event.code === 'Escape') {
      if (gamePhase === 'FIGHT') {
        gamePhase = 'PAUSED';
        bannerText = 'PAUSED - PRESS P TO RESUME';
      } else if (gamePhase === 'PAUSED') {
        gamePhase = 'FIGHT';
        bannerText = '';
      }

      return;
    }

    if (gamePhase !== 'FIGHT') {
      if (
        [
          'Space',
          'Enter',
          'KeyJ',
          'KeyK',
          'KeyL',
          'KeyZ',
          'KeyX',
          'KeyC',
        ].includes(event.code)
      ) {
        handleStartOrContinue();
      }

      return;
    }

    if (event.code === 'KeyJ' || event.code === 'KeyZ') {
      triggerAttack(player, 'PUNCH');
    }

    if (event.code === 'KeyK' || event.code === 'KeyX') {
      triggerAttack(player, 'KICK');
    }

    if (event.code === 'KeyL' || event.code === 'KeyC') {
      triggerAttack(player, 'LOW_KICK');
    }

    if (event.code === 'ShiftLeft' || event.code === 'ShiftRight') {
      tryDash(player);
    }
  });

  window.addEventListener('keyup', (event) => {
    keys[event.code] = false;
  });

  document.querySelectorAll<HTMLButtonElement>('.touch-btn').forEach((button) => {
    const code = button.dataset.key!;

    button.addEventListener('touchstart', (event) => {
      event.preventDefault();
      keys[code] = true;

      if (code === 'KeyR') {
        resetMatch();

        return;
      }

      if (code === 'KeyP') {
        if (gamePhase === 'FIGHT') {
          gamePhase = 'PAUSED';
          bannerText = 'PAUSED - PRESS PAUSE TO RESUME';
        } else if (gamePhase === 'PAUSED') {
          gamePhase = 'FIGHT';
          bannerText = '';
        }

        return;
      }

      if (gamePhase !== 'FIGHT') {
        handleStartOrContinue();

        return;
      }

      if (code === 'KeyJ') {
        triggerAttack(player, 'PUNCH');
      }

      if (code === 'KeyK') {
        triggerAttack(player, 'KICK');
      }

      if (code === 'KeyL') {
        triggerAttack(player, 'LOW_KICK');
      }

      if (code === 'ShiftLeft') {
        tryDash(player);
      }
    });

    button.addEventListener('touchend', (event) => {
      event.preventDefault();
      keys[code] = false;
    });
  });

  document.getElementById('reset-btn')?.addEventListener('click', resetMatch);

  document.getElementById('pause-btn')?.addEventListener('click', () => {
    if (gamePhase === 'FIGHT') {
      gamePhase = 'PAUSED';
      bannerText = 'PAUSED - PRESS P TO RESUME';
    } else if (gamePhase === 'PAUSED') {
      gamePhase = 'FIGHT';
      bannerText = '';
    }
  });

  document.getElementById('mute-btn')?.addEventListener('click', (event) => {
    muted = !muted;

    const target = event.target as HTMLElement;
    target.textContent = `PC Speaker: ${muted ? 'OFF' : 'ON'}`;
  });

  let tick = 0;

  requestAnimationFrame(loop);
</script>