---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-brand-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<title>{title} | Aleksandr Zhdanov</title>
	</head>
	<body class="bg-brand-dark text-slate-200 antialiased font-mono flex flex-col min-h-screen Selection:bg-brand-accent/30 selection:text-white">
		
		<!-- Engineering Header Branding Bar -->
		<header class="border-b border-slate-800 bg-brand-dark/80 backdrop-blur sticky top-0 z-50">
			<div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
					<a href={`${import.meta.env.BASE_URL}/`} class="text-sm font-bold tracking-tight hover:text-brand-accent transition-colors">
                        ajdanoff // <span class="text-brand-accent">MLOps & Infrastructure Engineer</span>
                    </a>
				</div>
				<nav class="flex items-center space-x-6 text-xs font-semibold tracking-wide text-slate-400">
				    <a href={`${import.meta.env.BASE_URL}/#projects`} class="hover:text-slate-100 transition-colors">/projects</a>
					<a href={`${import.meta.env.BASE_URL}/notes`} class="hover:text-brand-accent transition-colors">/notes</a>
					<a href={`${import.meta.env.BASE_URL}/#services`} class="hover:text-slate-100 transition-colors">/services</a>
					<a href="https://github.com" target="_blank" class="hover:text-brand-accent transition-colors">GitHub ↗</a>
				</nav>
			</div>
		</header>

		<!-- Main Workspace Canvas -->
		<main class="flex-grow max-w-5xl w-full mx-auto px-4 py-12">
			<slot />
		</main>

		<!-- Console System Footer -->
		<footer class="border-t border-slate-900 bg-brand-dark/40 text-[10px] text-slate-500 py-6 text-center tracking-wider">
			<div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-2">
				<div>© 2026 ALEKSANDR ZHDANOV // ST. PETERSBURG</div>
				<div>BUILT WITH ASTRO ENGINE // PERFORMANCE RATIO: 100%</div>
			</div>
		</footer>

	</body>
</html>
